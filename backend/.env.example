# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/travel_platform?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key
REFRESH_TOKEN_EXPIRES_IN=7d

# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# S3
S3_BUCKET_AVATARS=travel-avatars
S3_BUCKET_PLACES=travel-places
S3_BUCKET_REVIEWS=travel-reviews
S3_BUCKET_DOCUMENTS=travel-documents

# SES
SES_FROM_EMAIL=noreply@yourdomain.com
SES_VERIFIED_DOMAIN=yourdomain.com

# SQS
SQS_RATING_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/your-account/rating-calculation-queue
SQS_EMAIL_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/your-account/email-queue

# SNS
SNS_ADMIN_TOPIC_ARN=arn:aws:sns:ap-southeast-1:your-account:admin-notifications
SNS_BUSINESS_TOPIC_ARN=arn:aws:sns:ap-southeast-1:your-account:business-notifications

# Cognito (optional - if using AWS Cognito)
COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_REGION=ap-southeast-1

# OpenSearch (optional - if using OpenSearch)
OPENSEARCH_ENDPOINT=https://search-travel-xxxxx.ap-southeast-1.es.amazonaws.com
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=your-opensearch-password

# CloudFront
CLOUDFRONT_DOMAIN=https://d1234567890.cloudfront.net

# CORS
CORS_ORIGIN=http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
